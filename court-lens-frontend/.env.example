# CourtLens backend base URL. The FastAPI backend defaults to port 8000 when run with uvicorn.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Current backend authentication is optional API-key based development auth.
# Leave empty when the backend API_KEY is not configured.
VITE_API_KEY=
VITE_API_ACTOR_ID=demo-user

# Set to "true" only when the backend uses cookie authentication.
VITE_API_WITH_CREDENTIALS=false

# Frontend upload validation limits (keep aligned with backend configuration).
VITE_MAX_UPLOAD_MB=10
VITE_ALLOWED_FILE_TYPES=.pdf,.png,.jpg,.jpeg,.tif,.tiff,.txt,.docx
